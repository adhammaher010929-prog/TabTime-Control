{
  "manifest_version": 3,
  "name": "Focus Tab Lock",
  "version": "1.0.0",
  "description": "Lock your focus by whitelisting tabs or limiting the number of open tabs during a session.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
